// classification.schema — site tags, our own categories, and the user's
// custom fields.

namespace veil

import { Entity, Asset, RecordKind } from "./common"

/// A site's own label. Never curated or browsed, only used to filter.
model Tag extends Entity {
  @unique
  10 name: string
  11 aliases: [string]
}

/// Our own taxonomy, defined by us rather than any site. Media belongs to a
/// category when it carries any of the category's tags, so new site tags only
/// need mapping, never re-tagging.
model Category extends Entity {
  10 name: string

  @unique
  11 slug: string

  12 parent: ref<Category>?
  13 matchTags: [ref<Tag>]

  14 cover: Asset?
  15 position: i32
}

/// The value type of a custom field.
enum FieldType {
  1 text
  2 number
  3 boolean
  4 date
  5 choice
  6 choices
  7 url
}

/// A field the user added to some kinds of records. Values live in
/// UserState.fields under the definition's id, so filters and automation
/// conditions can use them.
model FieldDef extends Entity {
  10 name: string
  11 kinds: [RecordKind]
  12 fieldType: FieldType
  /// Allowed values for choice fields.
  13 options: [string]?
}
