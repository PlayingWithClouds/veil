// veil.schema — entry point: loads every domain file. Generate with
//   openschema schema/veil.schema --target <target> --out <dir>
//
// Domain files:
//   common          Entity base, references, assets, sources
//   classification  tags, categories, custom field definitions
//   people          performers, studios, cam models, groups
//   content         media: videos, galleries, images, audio, stories, posts
//   provenance      field sources, revisions, fingerprints, embeddings, alike, comments
//   playback        streams, files, storage, library roots, segments, clips, subtitles, scripts
//   user            user state, collections, filters, follows, events, limits, accounts
//   automation      automations, runs, notifications
//   system          devices, jobs, API tokens, plugins
//   features        matches and the feature operations

namespace veil

import { Entity } from "./common"
import { Tag } from "./classification"
import { Performer } from "./people"
import { Video } from "./content"
import { FieldSource } from "./provenance"
import { Stream } from "./playback"
import { UserState } from "./user"
import { Automation } from "./automation"
import { Device } from "./system"
import { Match } from "./features"
